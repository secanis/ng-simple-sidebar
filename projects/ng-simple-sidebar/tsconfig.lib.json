{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../out-tsc/lib",
        "declarationMap": true,
        "declaration": true,
        "inlineSources": true,
        "types": ["jest", "node"],
        "lib": ["dom", "es2022"],
        "module": "esnext",
        "moduleResolution": "bundler"
    },
    "angularCompilerOptions": {
        "skipTemplateCodegen": true,
        "strictMetadataEmit": true,
        "enableResourceInlining": true
    },
    "exclude": ["src/test.ts", "**/*.spec.ts"]
}