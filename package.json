{
  "name": "ng-simple-sidebar",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:watch": "ng build --watch",
    "build:showcase": "ng build --configuration production --project ng-simple-sidebar-showcase",
    "build:lib": "ng build --configuration production --project ng-simple-sidebar",
    "postbuild:lib": "copyfiles *.md *.MD LICENSE ./dist/ng-simple-sidebar",
    "test": "jest --config projects/ng-simple-sidebar/jest.config.js",
    "test:showcase": "jest --config projects/ng-simple-sidebar-showcase/jest.config.js",
    "lint": "ng lint",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "angular-eslint": "^22.1.0",
    "copyfiles": "^2.4.1",
    "cypress": "^14.0.0",
    "eslint": "^9.0.0",
    "gh-pages": "^6.3.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "ng-packagr": "^22.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "~10.9.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}